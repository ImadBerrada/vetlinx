  NEEDS_INFORMATION
  VERIFIED
  REJECTED

  @@schema("organizations")
}

model OrganizationVerificationRequest {
  id                 String                             @id @default(uuid()) @db.Uuid
  organizationId     String                             @unique @map("organization_id") @db.Uuid
  status             OrganizationVerificationStatus     @default(EVIDENCE_REQUIRED)
  assignedReviewerId String?                            @map("assigned_reviewer_id") @db.Uuid
  submittedAt        DateTime?                          @map("submitted_at") @db.Timestamptz(3)
  reviewedAt         DateTime?                          @map("reviewed_at") @db.Timestamptz(3)
  createdAt          DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
