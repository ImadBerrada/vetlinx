generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["appointments", "audit", "credentials", "files", "identity", "notifications", "organizations", "owners", "platform", "professionals", "recruitment", "verification"]
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED

  @@schema("identity")
}

enum SystemRole {
  PROFESSIONAL
  REVIEWER
  OPERATIONS_ADMIN
  PLATFORM_ADMIN

  @@schema("identity")
}

model Account {
  id                          String                             @id @default(uuid()) @db.Uuid
  email                       String                             @unique @db.VarChar(320)
  passwordHash                String                             @map("password_hash") @db.VarChar(255)
  status                      AccountStatus                      @default(PENDING)
  emailVerifiedAt             DateTime?                          @map("email_verified_at") @db.Timestamptz(3)
  authVersion                 Int                                @default(0) @map("auth_version")
  mfaSecretEncrypted          String?                            @map("mfa_secret_encrypted") @db.Text
  mfaEnabledAt                DateTime?                          @map("mfa_enabled_at") @db.Timestamptz(3)
  mfaPendingSecretEncrypted   String?                            @map("mfa_pending_secret_encrypted") @db.Text
  mfaPendingExpiresAt         DateTime?                          @map("mfa_pending_expires_at") @db.Timestamptz(3)
  mfaLastUsedStep             BigInt?                            @map("mfa_last_used_step")
  mfaFailedAttempts           Int                                @default(0) @map("mfa_failed_attempts")
  mfaLockedUntil              DateTime?                          @map("mfa_locked_until") @db.Timestamptz(3)
  mfaRecoveryCodes            MfaRecoveryCode[]
  mfaChallenges               MfaChallenge[]
  notificationPreference      NotificationPreference?
  securityTokens              SecurityToken[]
  createdAt                   DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  professional                ProfessionalProfile?
  owner                       OwnerProfile?
  appointments                Appointment[]
  bookingHolds                BookingHold[]
  memberships                 OrganizationMembership[]
  refreshSessions             RefreshSession[]
  systemRoles                 AccountSystemRole[]
  assignedReviews             VerificationRequest[]              @relation("AssignedReviewer")
  reviewDecisions             VerificationDecision[]
  notifications               Notification[]
  assignedOrganizationReviews OrganizationVerificationRequest[]  @relation("AssignedOrganizationReviewer")
  organizationReviewDecisions OrganizationVerificationDecision[]
  createdJobs                 Job[]                              @relation("JobCreator")

  @@map("accounts")
  @@schema("identity")
}

enum NotificationKind {
  VERIFICATION_INFORMATION_REQUESTED
  CREDENTIAL_VERIFIED
  CREDENTIAL_REJECTED
  CREDENTIAL_EXPIRED
  CREDENTIAL_REVOKED
  ORGANIZATION_INFORMATION_REQUESTED
  ORGANIZATION_VERIFIED
  ORGANIZATION_REJECTED
  JOB_APPLICATION_RECEIVED
  JOB_APPLICATION_STATUS_UPDATED
  INTERVIEW_SCHEDULED
  INTERVIEW_UPDATED
  OFFER_RECEIVED
  OFFER_UPDATED
  EMPLOYMENT_CONFIRMED
  EMPLOYMENT_ENDED
  APPOINTMENT_REQUESTED
  APPOINTMENT_UPDATED
  APPOINTMENT_REMINDER

  @@schema("notifications")
}

enum NotificationStatus {
  UNREAD
  READ

  @@schema("notifications")
}

model Notification {
  id                 String             @id @default(uuid()) @db.Uuid
  recipientAccountId String             @map("recipient_account_id") @db.Uuid
  kind               NotificationKind
  status             NotificationStatus @default(UNREAD)
  title              String             @db.VarChar(180)
  message            String             @db.Text
  resourceType       String             @map("resource_type") @db.VarChar(120)
  resourceId         String             @map("resource_id") @db.VarChar(120)
  deduplicationKey   String?            @unique @map("deduplication_key") @db.VarChar(240)
  readAt             DateTime?          @map("read_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  recipient          Account            @relation(fields: [recipientAccountId], references: [id], onDelete: Cascade)

  @@index([recipientAccountId, status, createdAt])
  @@map("notifications")
  @@schema("notifications")
}

model AccountSystemRole {
  id        String     @id @default(uuid()) @db.Uuid
  accountId String     @map("account_id") @db.Uuid
  role      SystemRole
  grantedBy String     @map("granted_by") @db.VarChar(120)
  grantedAt DateTime   @default(now()) @map("granted_at") @db.Timestamptz(3)
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, role])
  @@index([role, grantedAt])
  @@map("account_system_roles")
  @@schema("identity")
}

model NotificationPreference {
  accountId                 String   @id @map("account_id") @db.Uuid
  appointmentUpdatesEmail   Boolean  @default(true) @map("appointment_updates_email")
  appointmentRemindersEmail Boolean  @default(true) @map("appointment_reminders_email")
  credentialUpdatesEmail    Boolean  @default(true) @map("credential_updates_email")
  version                   Int      @default(0)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  account                   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
  @@schema("notifications")
}

model RefreshSession {
  id                 String    @id @default(uuid()) @db.Uuid
  accountId          String    @map("account_id") @db.Uuid
  familyId           String    @map("family_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash") @db.Char(64)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById       String?   @map("replaced_by_id") @db.Uuid
  userAgent          String?   @map("user_agent") @db.VarChar(500)
  ipAddress          String?   @map("ip_address") @db.Inet
  mfaAuthenticatedAt DateTime? @map("mfa_authenticated_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@index([familyId, revokedAt])
  @@map("refresh_sessions")
  @@schema("identity")
}

enum SecurityTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY

  @@schema("identity")
}

model SecurityToken {
  id        String               @id @default(uuid()) @db.Uuid
  accountId String               @map("account_id") @db.Uuid
  purpose   SecurityTokenPurpose
  tokenHash String               @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime             @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?            @map("used_at") @db.Timestamptz(3)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  account   Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, createdAt])
  @@map("security_tokens")
  @@schema("identity")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, usedAt])
  @@map("mfa_recovery_codes")
  @@schema("identity")
}

model MfaChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  authVersion Int       @map("auth_version")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  ipAddress   String?   @map("ip_address") @db.Inet
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@map("mfa_challenges")
  @@schema("identity")
}

enum ProfessionalStatus {
  DRAFT
  ACTIVE
  SUSPENDED

  @@schema("professionals")
}

enum PortfolioVisibility {
  PRIVATE
  UNLISTED
  PUBLIC

  @@schema("professionals")
}

enum ContactVisibility {
  PRIVATE
  VERIFIED_EMPLOYERS
  PUBLIC

  @@schema("professionals")
}

model ProfessionalProfile {
  id                String              @id @default(uuid()) @db.Uuid
  accountId         String              @unique @map("account_id") @db.Uuid
  displayName       String              @map("display_name") @db.VarChar(200)
  countryCode       String              @map("country_code") @db.Char(2)
  status            ProfessionalStatus  @default(DRAFT)
  headline          String?             @db.VarChar(220)
  summary           String?             @db.Text
  publicSlug        String?             @unique @map("public_slug") @db.VarChar(180)
  visibility        PortfolioVisibility @default(PRIVATE)
  contactVisibility ContactVisibility   @default(PRIVATE) @map("contact_visibility")
  specialtyCodes    String[]            @default([]) @map("specialty_codes")
  speciesCodes      String[]            @default([]) @map("species_codes")
  languageCodes     String[]            @default([]) @map("language_codes")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  account           Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  applications      JobApplication[]
  employments       Employment[]
  credentials       Credential[]

  @@index([countryCode, status])
  @@index([visibility, publicSlug])
  @@map("professional_profiles")
  @@schema("professionals")
}

enum CredentialStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  REJECTED
  EXPIRED
  REVOKED

  @@schema("credentials")
}

model Credential {
  id                    String                       @id @default(uuid()) @db.Uuid
  professionalProfileId String                       @map("professional_profile_id") @db.Uuid
  typeCode              String                       @map("type_code") @db.VarChar(60)
  title                 String                       @db.VarChar(250)
  issuingOrganization   String                       @map("issuing_organization") @db.VarChar(250)
  countryCode           String                       @map("country_code") @db.Char(2)
  issueDate             DateTime                     @map("issue_date") @db.Date
  expiryDate            DateTime?                    @map("expiry_date") @db.Date
  status                CredentialStatus             @default(DRAFT)
  submittedAt           DateTime?                    @map("submitted_at") @db.Timestamptz(3)
  lifecycleHistory      CredentialLifecycleHistory[]
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  professional          ProfessionalProfile          @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)

  @@index([professionalProfileId, status])
  @@index([countryCode, typeCode])
  @@map("credentials")
  @@schema("credentials")
}

model CredentialLifecycleHistory {
  id                    String           @id @default(uuid()) @db.Uuid
  credentialId          String           @map("credential_id") @db.Uuid
  actorAccountId        String?          @map("actor_account_id") @db.Uuid
  fromStatus            CredentialStatus @map("from_status")
  toStatus              CredentialStatus @map("to_status")
  reason                String           @db.VarChar(1000)
  source                String           @db.VarChar(40)
  verificationRequestId String?          @map("verification_request_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  credential            Credential       @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@index([credentialId, createdAt])
  @@map("credential_lifecycle_history")
  @@schema("credentials")
}

enum FileValidationStatus {
  VALIDATED
  QUARANTINED

  @@schema("files")
}

model FileObject {
  id               String               @id @default(uuid()) @db.Uuid
  ownerAccountId   String               @map("owner_account_id") @db.Uuid
  originalName     String               @map("original_name") @db.VarChar(255)
  mediaType        String               @map("media_type") @db.VarChar(120)
  byteSize         Int                  @map("byte_size")
  objectKey        String               @unique @map("object_key") @db.VarChar(500)
  checksumSha256   String               @map("checksum_sha256") @db.Char(64)
  validationStatus FileValidationStatus @default(VALIDATED) @map("validation_status")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerAccountId, createdAt])
  @@map("file_objects")
  @@schema("files")
}

enum VerificationRequestStatus {
  EVIDENCE_REQUIRED
  READY_TO_SUBMIT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  VERIFIED
  REJECTED
  CANCELLED

  @@schema("verification")
}

model VerificationRequest {
  id                    String                    @id @default(uuid()) @db.Uuid
  credentialId          String                    @unique @map("credential_id") @db.Uuid
  professionalProfileId String                    @map("professional_profile_id") @db.Uuid
  status                VerificationRequestStatus @default(EVIDENCE_REQUIRED)
  submittedAt           DateTime?                 @map("submitted_at") @db.Timestamptz(3)
  assignedReviewerId    String?                   @map("assigned_reviewer_id") @db.Uuid
  reviewedAt            DateTime?                 @map("reviewed_at") @db.Timestamptz(3)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  evidence              VerificationEvidence[]
  assignedReviewer      Account?                  @relation("AssignedReviewer", fields: [assignedReviewerId], references: [id], onDelete: Restrict)
  decisions             VerificationDecision[]

  @@index([professionalProfileId, status])
  @@index([status, submittedAt])
  @@index([assignedReviewerId, status])
  @@map("verification_requests")
  @@schema("verification")
}

enum VerificationDecisionAction {
  NEEDS_INFORMATION
  VERIFIED
  REJECTED

  @@schema("verification")
}

model VerificationDecision {
  id                    String                     @id @default(uuid()) @db.Uuid
  verificationRequestId String                     @map("verification_request_id") @db.Uuid
  reviewerAccountId     String                     @map("reviewer_account_id") @db.Uuid
  action                VerificationDecisionAction
  reason                String?                    @db.Text
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  verificationRequest   VerificationRequest        @relation(fields: [verificationRequestId], references: [id], onDelete: Restrict)
  reviewer              Account                    @relation(fields: [reviewerAccountId], references: [id], onDelete: Restrict)

  @@index([verificationRequestId, createdAt])
  @@index([reviewerAccountId, createdAt])
  @@map("verification_decisions")
  @@schema("verification")
}

model VerificationEvidence {
  id                    String              @id @default(uuid()) @db.Uuid
  verificationRequestId String              @map("verification_request_id") @db.Uuid
  fileObjectId          String              @unique @map("file_object_id") @db.Uuid
  kind                  String              @default("SUPPORTING_DOCUMENT") @db.VarChar(60)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@index([verificationRequestId, createdAt])
  @@map("verification_evidence")
  @@schema("verification")
}

enum OrganizationStatus {
  DRAFT
  VERIFICATION_PENDING
  VERIFIED
  REJECTED
  SUSPENDED
  CLOSED

  @@schema("organizations")
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  RECRUITER
  STAFF

  @@schema("organizations")
}

enum OrganizationType {
  CLINIC
  HOSPITAL
  LABORATORY
  UNIVERSITY
  COMPANY
  OTHER

  @@schema("organizations")
}

model Organization {
  id                           String                           @id @default(uuid()) @db.Uuid
  legalName                    String                           @map("legal_name") @db.VarChar(250)
  countryCode                  String                           @map("country_code") @db.Char(2)
  type                         OrganizationType                 @default(CLINIC)
  publicName                   String?                          @map("public_name") @db.VarChar(250)
  email                        String?                          @db.VarChar(320)
  phone                        String?                          @db.VarChar(40)
  website                      String?                          @db.VarChar(500)
  addressLine1                 String?                          @map("address_line_1") @db.VarChar(250)
  city                         String?                          @db.VarChar(120)
  region                       String?                          @db.VarChar(120)
  postalCode                   String?                          @map("postal_code") @db.VarChar(30)
  status                       OrganizationStatus               @default(DRAFT)
  acceptsAppointmentRequests   Boolean                          @default(false) @map("accepts_appointment_requests")
  appointmentSchedulingEnabled Boolean                          @default(false) @map("appointment_scheduling_enabled")
  clinicServices               ClinicService[]
  clinicResources              ClinicResource[]
  appointments                 Appointment[]
  createdAt                    DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)
  members                      OrganizationMembership[]
  invitations                  OrganizationInvitation[]
  verification                 OrganizationVerificationRequest?
  jobs                         Job[]
  employments                  Employment[]

  @@index([countryCode, status])
  @@map("organizations")
  @@schema("organizations")
}

model OwnerProfile {
  id           String        @id @default(uuid()) @db.Uuid
  accountId    String        @unique @map("account_id") @db.Uuid
  displayName  String        @map("display_name") @db.VarChar(200)
  countryCode  String        @map("country_code") @db.Char(2)
  phone        String        @db.VarChar(40)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pets         Pet[]
  appointments Appointment[]

  @@map("owner_profiles")
  @@schema("owners")
}

model Pet {
  id             String        @id @default(uuid()) @db.Uuid
  ownerProfileId String        @map("owner_profile_id") @db.Uuid
  name           String        @db.VarChar(100)
  speciesCode    String        @map("species_code") @db.VarChar(40)
  breed          String?       @db.VarChar(120)
  sex            String        @default("UNKNOWN") @db.VarChar(20)
  birthDate      DateTime?     @map("birth_date") @db.Date
  archivedAt     DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner          OwnerProfile  @relation(fields: [ownerProfileId], references: [id], onDelete: Restrict)
  appointments   Appointment[]
  bookingHolds   BookingHold[]

  @@index([ownerProfileId, archivedAt])
  @@map("pets")
  @@schema("owners")
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@schema("appointments")
}

model Appointment {
  id                  String                @id @default(uuid()) @db.Uuid
  requesterAccountId  String                @map("requester_account_id") @db.Uuid
  ownerProfileId      String                @map("owner_profile_id") @db.Uuid
  petId               String                @map("pet_id") @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  ownerName           String                @map("owner_name") @db.VarChar(200)
  contactPhone        String                @map("contact_phone") @db.VarChar(40)
  petName             String                @map("pet_name") @db.VarChar(100)
  speciesCode         String                @map("species_code") @db.VarChar(40)
  clinicName          String                @map("clinic_name") @db.VarChar(250)
  startsAt            DateTime              @map("starts_at") @db.Timestamptz(3)
  timeZone            String                @map("time_zone") @db.VarChar(100)
  visitReason         String                @map("visit_reason") @db.VarChar(1000)
  sharingConsentAt    DateTime              @map("sharing_consent_at") @db.Timestamptz(3)
  status              AppointmentStatus     @default(REQUESTED)
  responseNote        String?               @map("response_note") @db.VarChar(1000)
  proposedStartsAt    DateTime?             @map("proposed_starts_at") @db.Timestamptz(3)
  proposedTimeZone    String?               @map("proposed_time_zone") @db.VarChar(100)
  proposalExpiresAt   DateTime?             @map("proposal_expires_at") @db.Timestamptz(3)
  proposalVersion     Int                   @default(0) @map("proposal_version")
  proposedByAccountId String?               @map("proposed_by_account_id") @db.Uuid
  proposalReason      String?               @map("proposal_reason") @db.VarChar(1000)
  proposalInitiator   String?               @map("proposal_initiator") @db.VarChar(20)
  checkedInAt         DateTime?             @map("checked_in_at") @db.Timestamptz(3)
  slotId              String?               @map("slot_id") @db.Uuid
  proposedSlotId      String?               @map("proposed_slot_id") @db.Uuid
  requestHoldId       String?               @unique @map("request_hold_id") @db.Uuid
  serviceName         String?               @map("service_name") @db.VarChar(120)
  durationMinutes     Int?                  @map("duration_minutes")
  slot                AppointmentSlot?      @relation("BookedSlot", fields: [slotId], references: [id], onDelete: Restrict)
  proposedSlot        AppointmentSlot?      @relation("ProposedSlot", fields: [proposedSlotId], references: [id], onDelete: Restrict)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  history             AppointmentHistory[]
  reminderMarkers     AppointmentReminder[]
  requester           Account               @relation(fields: [requesterAccountId], references: [id], onDelete: Restrict)
  owner               OwnerProfile          @relation(fields: [ownerProfileId], references: [id], onDelete: Restrict)
  pet                 Pet                   @relation(fields: [petId], references: [id], onDelete: Restrict)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([requesterAccountId, startsAt])
  @@index([organizationId, status, startsAt])
  @@index([slotId, status])
  @@map("appointments")
  @@schema("appointments")
}

model AppointmentHistory {
  id                String             @id @default(uuid()) @db.Uuid
  appointmentId     String             @map("appointment_id") @db.Uuid
  actorAccountId    String             @map("actor_account_id") @db.Uuid
  fromStatus        AppointmentStatus? @map("from_status")
  toStatus          AppointmentStatus  @map("to_status")
  reason            String?            @db.VarChar(1000)
  action            String             @default("STATUS_CHANGED") @db.VarChar(40)
  proposedStartsAt  DateTime?          @map("proposed_starts_at") @db.Timestamptz(3)
  proposedTimeZone  String?            @map("proposed_time_zone") @db.VarChar(100)
  proposalVersion   Int?               @map("proposal_version")
  proposalExpiresAt DateTime?          @map("proposal_expires_at") @db.Timestamptz(3)
  proposalInitiator String?            @map("proposal_initiator") @db.VarChar(20)
  slotId            String?            @map("slot_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  appointment       Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([appointmentId, createdAt])
  @@map("appointment_history")
  @@schema("appointments")
}

model ClinicService {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  name            String            @db.VarChar(120)
  description     String            @db.VarChar(1000)
  durationMinutes Int               @map("duration_minutes")
  active          Boolean           @default(false)
  version         Int               @default(0)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slots           AppointmentSlot[]

  @@index([organizationId, active])
  @@map("clinic_services")
  @@schema("appointments")
}

model AppointmentSlot {
  id           String        @id @default(uuid()) @db.Uuid
  serviceId    String        @map("service_id") @db.Uuid
  startsAt     DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime      @map("ends_at") @db.Timestamptz(3)
  timeZone     String        @map("time_zone") @db.VarChar(100)
  capacity     Int           @default(1)
  published    Boolean       @default(true)
  resourcesReserved Boolean  @default(true) @map("resources_reserved")
  version      Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  service      ClinicService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  holds        BookingHold[]
  appointments Appointment[] @relation("BookedSlot")
  proposals    Appointment[] @relation("ProposedSlot")
  resources    SlotResource[]

  @@unique([serviceId, startsAt])
  @@index([serviceId, published, startsAt])
  @@map("appointment_slots")
  @@schema("appointments")
}

model ClinicResource {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String @db.VarChar(120)
  kind           String @db.VarChar(20)
  active         Boolean @default(true)
  version        Int @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  slots          SlotResource[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active])
  @@map("clinic_resources")
  @@schema("appointments")
}

model SlotResource {
  slotId     String @map("slot_id") @db.Uuid
  resourceId String @map("resource_id") @db.Uuid
  slot       AppointmentSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  resource   ClinicResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([slotId, resourceId])
  @@index([resourceId, slotId])
  @@map("slot_resources")
  @@schema("appointments")
}

model BookingHold {
  id         String          @id @db.Uuid
  slotId     String          @map("slot_id") @db.Uuid
  accountId  String          @map("account_id") @db.Uuid
  petId      String          @map("pet_id") @db.Uuid
  expiresAt  DateTime        @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?       @map("consumed_at") @db.Timestamptz(3)
  releasedAt DateTime?       @map("released_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  slot       AppointmentSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  account    Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pet        Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([slotId, expiresAt])
  @@index([accountId, expiresAt])
  @@map("booking_holds")
  @@schema("appointments")
}

model AppointmentReminder {
  idempotencyKey String      @id @map("idempotency_key") @db.VarChar(160)
  appointmentId  String      @map("appointment_id") @db.Uuid
  startsAt       DateTime    @map("starts_at") @db.Timestamptz(3)
  queuedAt       DateTime    @default(now()) @map("queued_at") @db.Timestamptz(3)
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, startsAt])
  @@map("appointment_reminders")
  @@schema("appointments")
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED

  @@schema("recruitment")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  LOCUM
  CONTRACT
  INTERNSHIP

  @@schema("recruitment")
}

enum WorkMode {
  ON_SITE
  HYBRID
  REMOTE

  @@schema("recruitment")
}

enum JobRequirementCategory {
  SPECIALTY
  SPECIES
  LICENCE
  LANGUAGE
  QUALIFICATION

  @@schema("recruitment")
}

model Job {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  createdByAccountId String           @map("created_by_account_id") @db.Uuid
  title              String           @db.VarChar(180)
  description        String           @db.Text
  countryCode        String           @map("country_code") @db.Char(2)
  city               String           @db.VarChar(120)
  employmentType     EmploymentType   @map("employment_type")
  workMode           WorkMode         @map("work_mode")
  minExperienceYears Int              @default(0) @map("min_experience_years")
  salaryMinMonthly   Int?             @map("salary_min_monthly")
  salaryMaxMonthly   Int?             @map("salary_max_monthly")
  currencyCode       String?          @map("currency_code") @db.Char(3)
  status             JobStatus        @default(DRAFT)
  publishedAt        DateTime?        @map("published_at") @db.Timestamptz(3)
  closingAt          DateTime?        @map("closing_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          Account          @relation("JobCreator", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  requirements       JobRequirement[]
  applications       JobApplication[]
  employments        Employment[]

  @@index([organizationId, status, createdAt])
  @@index([status, countryCode, city, publishedAt])
  @@map("jobs")
  @@schema("recruitment")
}

model JobRequirement {
  id        String                 @id @default(uuid()) @db.Uuid
  jobId     String                 @map("job_id") @db.Uuid
  category  JobRequirementCategory
  valueCode String                 @map("value_code") @db.VarChar(120)
  label     String                 @db.VarChar(180)
  required  Boolean                @default(true)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  job       Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, category, valueCode])
  @@index([category, valueCode])
  @@map("job_requirements")
  @@schema("recruitment")
}

enum JobApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEWING
  OFFERED
  REJECTED
  WITHDRAWN
  HIRED

  @@schema("recruitment")
}

model JobApplication {
  id                    String                  @id @default(uuid()) @db.Uuid
  jobId                 String                  @map("job_id") @db.Uuid
  professionalProfileId String                  @map("professional_profile_id") @db.Uuid
  coverNote             String?                 @map("cover_note") @db.Text
  status                JobApplicationStatus    @default(SUBMITTED)
  submittedAt           DateTime                @default(now()) @map("submitted_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  job                   Job                     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  professional          ProfessionalProfile     @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  history               JobApplicationHistory[]
  interviews            Interview[]
  offers                JobOffer[]

  @@unique([jobId, professionalProfileId])
  @@index([professionalProfileId, status, submittedAt])
  @@index([jobId, status, submittedAt])
  @@map("job_applications")
  @@schema("recruitment")
}

enum InterviewMode {
  VIDEO
  PHONE
  IN_PERSON

  @@schema("recruitment")
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED

  @@schema("recruitment")
}

model Interview {
  id                   String          @id @default(uuid()) @db.Uuid
  applicationId        String          @map("application_id") @db.Uuid
  scheduledByAccountId String          @map("scheduled_by_account_id") @db.Uuid
  startsAt             DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime        @map("ends_at") @db.Timestamptz(3)
  timeZone             String          @map("time_zone") @db.VarChar(80)
  mode                 InterviewMode
  location             String?         @db.VarChar(500)
  joinUrl              String?         @map("join_url") @db.VarChar(1000)
  notes                String?         @db.Text
  status               InterviewStatus @default(SCHEDULED)
  cancellationReason   String?         @map("cancellation_reason") @db.Text
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  application          JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, startsAt])
  @@index([status, startsAt])
  @@map("interviews")
  @@schema("recruitment")
}

enum JobOfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED

  @@schema("recruitment")
}

model JobOffer {
  id                 String         @id @default(uuid()) @db.Uuid
  applicationId      String         @map("application_id") @db.Uuid
  createdByAccountId String         @map("created_by_account_id") @db.Uuid
  salaryMonthly      Int            @map("salary_monthly")
  currencyCode       String         @map("currency_code") @db.Char(3)
  proposedStartDate  DateTime       @map("proposed_start_date") @db.Date
  expiresAt          DateTime       @map("expires_at") @db.Timestamptz(3)
  terms              String         @db.Text
  status             JobOfferStatus @default(DRAFT)
  sentAt             DateTime?      @map("sent_at") @db.Timestamptz(3)
  respondedAt        DateTime?      @map("responded_at") @db.Timestamptz(3)
  responseReason     String?        @map("response_reason") @db.Text
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  application        JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employment         Employment?

  @@index([applicationId, status, createdAt])
  @@index([status, expiresAt])
  @@map("job_offers")
  @@schema("recruitment")
}

enum EmploymentStatus {
  CONFIRMED
  ACTIVE
  ENDED
  CANCELLED

  @@schema("recruitment")
}

model Employment {
  id                    String              @id @default(uuid()) @db.Uuid
  offerId               String              @unique @map("offer_id") @db.Uuid
  jobId                 String              @map("job_id") @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  professionalProfileId String              @map("professional_profile_id") @db.Uuid
  confirmedByAccountId  String              @map("confirmed_by_account_id") @db.Uuid
  title                 String              @db.VarChar(180)
  employmentType        EmploymentType      @map("employment_type")
  startDate             DateTime            @map("start_date") @db.Date
  endDate               DateTime?           @map("end_date") @db.Date
  status                EmploymentStatus    @default(ACTIVE)
  verificationSource    String              @default("ORGANIZATION_CONFIRMED") @map("verification_source") @db.VarChar(80)
  confirmedAt           DateTime            @default(now()) @map("confirmed_at") @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  offer                 JobOffer            @relation(fields: [offerId], references: [id], onDelete: Restrict)
  job                   Job                 @relation(fields: [jobId], references: [id], onDelete: Restrict)
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  professional          ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  history               EmploymentHistory[]

  @@index([professionalProfileId, status, startDate])
  @@index([organizationId, status, startDate])
  @@map("employments")
  @@schema("recruitment")
}

model EmploymentHistory {
  id             String            @id @default(uuid()) @db.Uuid
  employmentId   String            @map("employment_id") @db.Uuid
  fromStatus     EmploymentStatus? @map("from_status")
  toStatus       EmploymentStatus  @map("to_status")
  actorAccountId String            @map("actor_account_id") @db.Uuid
  reason         String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  employment     Employment        @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@index([employmentId, createdAt])
  @@map("employment_history")
  @@schema("recruitment")
}

model JobApplicationHistory {
  id             String                @id @default(uuid()) @db.Uuid
  applicationId  String                @map("application_id") @db.Uuid
  fromStatus     JobApplicationStatus? @map("from_status")
  toStatus       JobApplicationStatus  @map("to_status")
  actorAccountId String                @map("actor_account_id") @db.Uuid
  reason         String?               @db.Text
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  application    JobApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("job_application_history")
  @@schema("recruitment")
}

