generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["audit", "credentials", "files", "identity", "licensing", "notifications", "organizations", "platform", "professionals", "recruitment", "verification"]
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED

  @@schema("identity")
}

enum SystemRole {
  PROFESSIONAL
  REVIEWER
  LICENSING_CURATOR
  LICENSING_REVIEWER
  OPERATIONS_ADMIN
  PLATFORM_ADMIN

  @@schema("identity")
}

model Account {
  id                          String                             @id @default(uuid()) @db.Uuid
  email                       String                             @unique @db.VarChar(320)
  passwordHash                String                             @map("password_hash") @db.VarChar(255)
  status                      AccountStatus                      @default(PENDING)
  createdAt                   DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  professional                ProfessionalProfile?
  memberships                 OrganizationMembership[]
  refreshSessions             RefreshSession[]
  systemRoles                 AccountSystemRole[]
  assignedReviews             VerificationRequest[]              @relation("AssignedReviewer")
  reviewDecisions             VerificationDecision[]
  notifications               Notification[]
  assignedOrganizationReviews OrganizationVerificationRequest[]  @relation("AssignedOrganizationReviewer")
  organizationReviewDecisions OrganizationVerificationDecision[]
  createdJobs                 Job[]                              @relation("JobCreator")
  reviewedPathwayVersions     LicencePathwayVersion[]            @relation("LicensingPathwayReviewer")
  licensingReminderPreference LicensingReminderPreference?
  licensingMutationReceipts   LicensingMutationReceipt[]

  @@map("accounts")
  @@schema("identity")
}

enum NotificationKind {
  VERIFICATION_INFORMATION_REQUESTED
  CREDENTIAL_VERIFIED
  CREDENTIAL_REJECTED
  ORGANIZATION_INFORMATION_REQUESTED
  ORGANIZATION_VERIFIED
  ORGANIZATION_REJECTED
  JOB_APPLICATION_RECEIVED
  JOB_APPLICATION_STATUS_UPDATED
  INTERVIEW_SCHEDULED
  INTERVIEW_UPDATED
  OFFER_RECEIVED
  OFFER_UPDATED
  EMPLOYMENT_CONFIRMED
  EMPLOYMENT_ENDED
  LICENCE_RENEWAL_DUE

  @@schema("notifications")
}

enum NotificationStatus {
  UNREAD
  READ

  @@schema("notifications")
}

model Notification {
  id                 String             @id @default(uuid()) @db.Uuid
  recipientAccountId String             @map("recipient_account_id") @db.Uuid
  kind               NotificationKind
  status             NotificationStatus @default(UNREAD)
  title              String             @db.VarChar(180)
  message            String             @db.Text
  resourceType       String             @map("resource_type") @db.VarChar(120)
  resourceId         String             @map("resource_id") @db.VarChar(120)
  readAt             DateTime?          @map("read_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  recipient          Account            @relation(fields: [recipientAccountId], references: [id], onDelete: Cascade)

  @@index([recipientAccountId, status, createdAt])
  @@map("notifications")
  @@schema("notifications")
}

model AccountSystemRole {
  id        String     @id @default(uuid()) @db.Uuid
  accountId String     @map("account_id") @db.Uuid
  role      SystemRole
  grantedBy String     @map("granted_by") @db.VarChar(120)
  grantedAt DateTime   @default(now()) @map("granted_at") @db.Timestamptz(3)
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, role])
  @@index([role, grantedAt])
  @@map("account_system_roles")
  @@schema("identity")
}

model RefreshSession {
  id           String    @id @default(uuid()) @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  ipAddress    String?   @map("ip_address") @db.Inet
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@index([familyId, revokedAt])
  @@map("refresh_sessions")
  @@schema("identity")
}

enum ProfessionalStatus {
  DRAFT
  ACTIVE
  SUSPENDED

  @@schema("professionals")
}

enum PortfolioVisibility {
  PRIVATE
  UNLISTED
  PUBLIC

  @@schema("professionals")
}

enum ContactVisibility {
  PRIVATE
  VERIFIED_EMPLOYERS
  PUBLIC

  @@schema("professionals")
}

model ProfessionalProfile {
  id                 String              @id @default(uuid()) @db.Uuid
  accountId          String              @unique @map("account_id") @db.Uuid
  displayName        String              @map("display_name") @db.VarChar(200)
  countryCode        String              @map("country_code") @db.Char(2)
  status             ProfessionalStatus  @default(DRAFT)
  headline           String?             @db.VarChar(220)
  summary            String?             @db.Text
  publicSlug         String?             @unique @map("public_slug") @db.VarChar(180)
  visibility         PortfolioVisibility @default(PRIVATE)
  contactVisibility  ContactVisibility   @default(PRIVATE) @map("contact_visibility")
  specialtyCodes     String[]            @default([]) @map("specialty_codes")
  speciesCodes       String[]            @default([]) @map("species_codes")
  languageCodes      String[]            @default([]) @map("language_codes")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  account            Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  applications       JobApplication[]
  employments        Employment[]
  credentials        Credential[]
  pathwayEnrollments PathwayEnrollment[]

  @@index([countryCode, status])
  @@index([visibility, publicSlug])
  @@map("professional_profiles")
  @@schema("professionals")
}

enum CredentialStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  REJECTED
  EXPIRED
  REVOKED

  @@schema("credentials")
}

model Credential {
  id                    String                @id @default(uuid()) @db.Uuid
  professionalProfileId String                @map("professional_profile_id") @db.Uuid
  typeCode              String                @map("type_code") @db.VarChar(60)
  title                 String                @db.VarChar(250)
  issuingOrganization   String                @map("issuing_organization") @db.VarChar(250)
  countryCode           String                @map("country_code") @db.Char(2)
  issueDate             DateTime              @map("issue_date") @db.Date
  expiryDate            DateTime?             @map("expiry_date") @db.Date
  status                CredentialStatus      @default(DRAFT)
  submittedAt           DateTime?             @map("submitted_at") @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  professional          ProfessionalProfile   @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  requirementProgress   RequirementProgress[]
  professionalLicence   ProfessionalLicence?

  @@index([professionalProfileId, status])
  @@index([countryCode, typeCode])
  @@index([expiryDate, status])
  @@map("credentials")
  @@schema("credentials")
}

enum PathwayVersionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  SUPERSEDED
  WITHDRAWN

  @@schema("licensing")
}

enum PathwayEnrollmentStatus {
  ACTIVE
  SUBMITTED_EXTERNALLY
  APPROVED
  REJECTED
  WITHDRAWN

  @@schema("licensing")
}

enum RequirementProgressState {
  MISSING
  IN_PROGRESS
  SATISFIED
  NEEDS_REVIEW
  NOT_APPLICABLE

  @@schema("licensing")
}

enum ExternalLicenceApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN

  @@schema("licensing")
}

enum LicenceApplicationVerificationSource {
  USER_REPORTED
  AUTHORITY_INTEGRATION

  @@schema("licensing")
}

enum ProfessionalLicenceStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED

  @@schema("licensing")
}

model LicensingJurisdiction {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique @db.VarChar(80)
  nameEn      String               @map("name_en") @db.VarChar(200)
  nameAr      String               @map("name_ar") @db.VarChar(200)
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  authorities LicensingAuthority[]
  pathways    LicencePathway[]

  @@index([active, nameEn])
  @@map("jurisdictions")
  @@schema("licensing")
}

model LicensingAuthority {
  id             String                @id @default(uuid()) @db.Uuid
  jurisdictionId String                @map("jurisdiction_id") @db.Uuid
  code           String                @db.VarChar(100)
  nameEn         String                @map("name_en") @db.VarChar(250)
  nameAr         String                @map("name_ar") @db.VarChar(250)
  websiteUrl     String                @map("website_url") @db.VarChar(1000)
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  jurisdiction   LicensingJurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  pathways       LicencePathway[]
  licences       ProfessionalLicence[]

  @@unique([jurisdictionId, code])
  @@index([jurisdictionId, active, nameEn])
  @@map("authorities")
  @@schema("licensing")
}

model LicenceType {
  id                    String           @id @default(uuid()) @db.Uuid
  code                  String           @unique @db.VarChar(100)
  nameEn                String           @map("name_en") @db.VarChar(200)
  nameAr                String           @map("name_ar") @db.VarChar(200)
  professionalTitleCode String           @map("professional_title_code") @db.VarChar(100)
  active                Boolean          @default(true)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  pathways              LicencePathway[]

  @@index([active, professionalTitleCode])
  @@map("licence_types")
  @@schema("licensing")
}

model LicencePathway {
  id             String                  @id @default(uuid()) @db.Uuid
  jurisdictionId String                  @map("jurisdiction_id") @db.Uuid
  authorityId    String                  @map("authority_id") @db.Uuid
  licenceTypeId  String                  @map("licence_type_id") @db.Uuid
  slug           String                  @db.VarChar(180)
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  jurisdiction   LicensingJurisdiction   @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  authority      LicensingAuthority      @relation(fields: [authorityId], references: [id], onDelete: Restrict)
  licenceType    LicenceType             @relation(fields: [licenceTypeId], references: [id], onDelete: Restrict)
  versions       LicencePathwayVersion[]

  @@unique([jurisdictionId, authorityId, licenceTypeId, slug])
  @@index([jurisdictionId, licenceTypeId, active])
  @@index([authorityId, active])
  @@map("licence_pathways")
  @@schema("licensing")
}

model LicencePathwayVersion {
  id                  String               @id @default(uuid()) @db.Uuid
  pathwayId           String               @map("pathway_id") @db.Uuid
  version             Int
  status              PathwayVersionStatus @default(DRAFT)
  effectiveFrom       DateTime?            @map("effective_from") @db.Date
  effectiveTo         DateTime?            @map("effective_to") @db.Date
  sourceUrl           String               @map("source_url") @db.VarChar(1000)
  sourceTitle         String               @map("source_title") @db.VarChar(300)
  reviewedAt          DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  reviewedByAccountId String?              @map("reviewed_by_account_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  pathway             LicencePathway       @relation(fields: [pathwayId], references: [id], onDelete: Restrict)
  reviewedBy          Account?             @relation("LicensingPathwayReviewer", fields: [reviewedByAccountId], references: [id], onDelete: Restrict)
  requirements        PathwayRequirement[]
  enrollments         PathwayEnrollment[]

  @@unique([pathwayId, version])
  @@index([status, effectiveFrom])
  @@index([reviewedByAccountId, reviewedAt])
  @@map("licence_pathway_versions")
  @@schema("licensing")
}

model PathwayRequirement {
  id               String                @id @default(uuid()) @db.Uuid
  pathwayVersionId String                @map("pathway_version_id") @db.Uuid
  code             String                @db.VarChar(120)
  titleEn          String                @map("title_en") @db.VarChar(250)
  titleAr          String                @map("title_ar") @db.VarChar(250)
  descriptionEn    String                @map("description_en") @db.Text
  descriptionAr    String                @map("description_ar") @db.Text
  position         Int
  required         Boolean               @default(true)
  rule             Json
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  pathwayVersion   LicencePathwayVersion @relation(fields: [pathwayVersionId], references: [id], onDelete: Restrict)
  progress         RequirementProgress[]

  @@unique([pathwayVersionId, code])
  @@unique([pathwayVersionId, position])
  @@index([pathwayVersionId, required])
  @@map("pathway_requirements")
  @@schema("licensing")
}

model PathwayEnrollment {
  id                    String                      @id @default(uuid()) @db.Uuid
  professionalProfileId String                      @map("professional_profile_id") @db.Uuid
  pathwayVersionId      String                      @map("pathway_version_id") @db.Uuid
  status                PathwayEnrollmentStatus     @default(ACTIVE)
  startedAt             DateTime                    @default(now()) @map("started_at") @db.Timestamptz(3)
  submittedExternallyAt DateTime?                   @map("submitted_externally_at") @db.Timestamptz(3)
  completedAt           DateTime?                   @map("completed_at") @db.Timestamptz(3)
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  professional          ProfessionalProfile         @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  pathwayVersion        LicencePathwayVersion       @relation(fields: [pathwayVersionId], references: [id], onDelete: Restrict)
  requirementProgress   RequirementProgress[]
  externalApplication   ExternalLicenceApplication?
  professionalLicence   ProfessionalLicence?

  @@unique([professionalProfileId, pathwayVersionId])
  @@index([professionalProfileId, status, startedAt])
  @@index([pathwayVersionId, status])
  @@map("pathway_enrollments")
  @@schema("licensing")
}

model RequirementProgress {
  id                 String                   @id @default(uuid()) @db.Uuid
  enrollmentId       String                   @map("enrollment_id") @db.Uuid
  requirementId      String                   @map("requirement_id") @db.Uuid
  state              RequirementProgressState @default(MISSING)
  linkedCredentialId String?                  @map("linked_credential_id") @db.Uuid
  note               String?                  @db.Text
  evaluatedAt        DateTime                 @default(now()) @map("evaluated_at") @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  enrollment         PathwayEnrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  requirement        PathwayRequirement       @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  linkedCredential   Credential?              @relation(fields: [linkedCredentialId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, requirementId])
  @@index([linkedCredentialId, state])
  @@index([state, evaluatedAt])
  @@map("requirement_progress")
  @@schema("licensing")
}

model ExternalLicenceApplication {
  id                 String                               @id @default(uuid()) @db.Uuid
  enrollmentId       String                               @unique @map("enrollment_id") @db.Uuid
  authorityReference String                               @map("authority_reference") @db.VarChar(200)
  submittedAt        DateTime                             @map("submitted_at") @db.Timestamptz(3)
  status             ExternalLicenceApplicationStatus     @default(SUBMITTED)
  verificationSource LicenceApplicationVerificationSource @default(USER_REPORTED) @map("verification_source")
  lastReportedAt     DateTime                             @default(now()) @map("last_reported_at") @db.Timestamptz(3)
  createdAt          DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(3)
  enrollment         PathwayEnrollment                    @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@index([status, lastReportedAt])
  @@map("external_licence_applications")
  @@schema("licensing")
}

model ProfessionalLicence {
  id            String                    @id @default(uuid()) @db.Uuid
  credentialId  String                    @unique @map("credential_id") @db.Uuid
  enrollmentId  String                    @unique @map("enrollment_id") @db.Uuid
  authorityId   String                    @map("authority_id") @db.Uuid
  licenceNumber String                    @map("licence_number") @db.VarChar(160)
  status        ProfessionalLicenceStatus @default(ACTIVE)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  credential    Credential                @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  enrollment    PathwayEnrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  authority     LicensingAuthority        @relation(fields: [authorityId], references: [id], onDelete: Restrict)

  @@unique([authorityId, licenceNumber])
  @@index([authorityId, status])
  @@map("professional_licences")
  @@schema("licensing")
}

model LicensingReminderPreference {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @unique @map("account_id") @db.Uuid
  timeZone       String   @map("time_zone") @db.VarChar(80)
  renewalEnabled Boolean  @default(true) @map("renewal_enabled")
  leadDays       Int      @default(90) @map("lead_days")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([renewalEnabled, leadDays])
  @@map("licensing_reminder_preferences")
  @@schema("licensing")
}

model LicensingMutationReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  operation      String   @db.VarChar(120)
  idempotencyKey String   @map("idempotency_key") @db.Uuid
  requestHash    String   @map("request_hash") @db.Char(64)
  resourceId     String   @map("resource_id") @db.VarChar(120)
  responseStatus Int      @map("response_status")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, operation, idempotencyKey])
  @@index([createdAt])
  @@map("licensing_mutation_receipts")
  @@schema("licensing")
}

enum FileValidationStatus {
  VALIDATED
  QUARANTINED

  @@schema("files")
}

model FileObject {
  id               String               @id @default(uuid()) @db.Uuid
  ownerAccountId   String               @map("owner_account_id") @db.Uuid
  originalName     String               @map("original_name") @db.VarChar(255)
  mediaType        String               @map("media_type") @db.VarChar(120)
  byteSize         Int                  @map("byte_size")
  objectKey        String               @unique @map("object_key") @db.VarChar(500)
  checksumSha256   String               @map("checksum_sha256") @db.Char(64)
  validationStatus FileValidationStatus @default(VALIDATED) @map("validation_status")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerAccountId, createdAt])
  @@map("file_objects")
  @@schema("files")
}

enum VerificationRequestStatus {
  EVIDENCE_REQUIRED
  READY_TO_SUBMIT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  VERIFIED
  REJECTED
  CANCELLED

  @@schema("verification")
}

model VerificationRequest {
  id                    String                    @id @default(uuid()) @db.Uuid
  credentialId          String                    @unique @map("credential_id") @db.Uuid
  professionalProfileId String                    @map("professional_profile_id") @db.Uuid
  status                VerificationRequestStatus @default(EVIDENCE_REQUIRED)
  submittedAt           DateTime?                 @map("submitted_at") @db.Timestamptz(3)
  assignedReviewerId    String?                   @map("assigned_reviewer_id") @db.Uuid
  reviewedAt            DateTime?                 @map("reviewed_at") @db.Timestamptz(3)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  evidence              VerificationEvidence[]
  assignedReviewer      Account?                  @relation("AssignedReviewer", fields: [assignedReviewerId], references: [id], onDelete: Restrict)
  decisions             VerificationDecision[]

  @@index([professionalProfileId, status])
  @@index([status, submittedAt])
  @@index([assignedReviewerId, status])
  @@map("verification_requests")
  @@schema("verification")
}

enum VerificationDecisionAction {
  NEEDS_INFORMATION
  VERIFIED
  REJECTED

  @@schema("verification")
}

model VerificationDecision {
  id                    String                     @id @default(uuid()) @db.Uuid
  verificationRequestId String                     @map("verification_request_id") @db.Uuid
  reviewerAccountId     String                     @map("reviewer_account_id") @db.Uuid
  action                VerificationDecisionAction
  reason                String?                    @db.Text
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  verificationRequest   VerificationRequest        @relation(fields: [verificationRequestId], references: [id], onDelete: Restrict)
  reviewer              Account                    @relation(fields: [reviewerAccountId], references: [id], onDelete: Restrict)

  @@index([verificationRequestId, createdAt])
  @@index([reviewerAccountId, createdAt])
  @@map("verification_decisions")
  @@schema("verification")
}

model VerificationEvidence {
  id                    String              @id @default(uuid()) @db.Uuid
  verificationRequestId String              @map("verification_request_id") @db.Uuid
  fileObjectId          String              @unique @map("file_object_id") @db.Uuid
  kind                  String              @default("SUPPORTING_DOCUMENT") @db.VarChar(60)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@index([verificationRequestId, createdAt])
  @@map("verification_evidence")
  @@schema("verification")
}

enum OrganizationStatus {
  DRAFT
  VERIFICATION_PENDING
  VERIFIED
  REJECTED
  SUSPENDED
  CLOSED

  @@schema("organizations")
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  RECRUITER
  STAFF

  @@schema("organizations")
}

enum OrganizationType {
  CLINIC
  HOSPITAL
  LABORATORY
  UNIVERSITY
  COMPANY
  OTHER

  @@schema("organizations")
}

model Organization {
  id           String                           @id @default(uuid()) @db.Uuid
  legalName    String                           @map("legal_name") @db.VarChar(250)
  countryCode  String                           @map("country_code") @db.Char(2)
  type         OrganizationType                 @default(CLINIC)
  publicName   String?                          @map("public_name") @db.VarChar(250)
  email        String?                          @db.VarChar(320)
  phone        String?                          @db.VarChar(40)
  website      String?                          @db.VarChar(500)
  addressLine1 String?                          @map("address_line_1") @db.VarChar(250)
  city         String?                          @db.VarChar(120)
  region       String?                          @db.VarChar(120)
  postalCode   String?                          @map("postal_code") @db.VarChar(30)
  status       OrganizationStatus               @default(DRAFT)
  createdAt    DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)
  members      OrganizationMembership[]
  invitations  OrganizationInvitation[]
  verification OrganizationVerificationRequest?
  jobs         Job[]
  employments  Employment[]

  @@index([countryCode, status])
  @@map("organizations")
  @@schema("organizations")
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED

  @@schema("recruitment")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  LOCUM
  CONTRACT
  INTERNSHIP

  @@schema("recruitment")
}

enum WorkMode {
  ON_SITE
  HYBRID
  REMOTE

  @@schema("recruitment")
}

enum JobRequirementCategory {
  SPECIALTY
  SPECIES
  LICENCE
  LANGUAGE
  QUALIFICATION

  @@schema("recruitment")
}

model Job {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  createdByAccountId String           @map("created_by_account_id") @db.Uuid
  title              String           @db.VarChar(180)
  description        String           @db.Text
  countryCode        String           @map("country_code") @db.Char(2)
  city               String           @db.VarChar(120)
  employmentType     EmploymentType   @map("employment_type")
  workMode           WorkMode         @map("work_mode")
  minExperienceYears Int              @default(0) @map("min_experience_years")
  salaryMinMonthly   Int?             @map("salary_min_monthly")
  salaryMaxMonthly   Int?             @map("salary_max_monthly")
  currencyCode       String?          @map("currency_code") @db.Char(3)
  status             JobStatus        @default(DRAFT)
  publishedAt        DateTime?        @map("published_at") @db.Timestamptz(3)
  closingAt          DateTime?        @map("closing_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          Account          @relation("JobCreator", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  requirements       JobRequirement[]
  applications       JobApplication[]
  employments        Employment[]

  @@index([organizationId, status, createdAt])
  @@index([status, countryCode, city, publishedAt])
  @@map("jobs")
  @@schema("recruitment")
}

model JobRequirement {
  id        String                 @id @default(uuid()) @db.Uuid
  jobId     String                 @map("job_id") @db.Uuid
  category  JobRequirementCategory
  valueCode String                 @map("value_code") @db.VarChar(120)
  label     String                 @db.VarChar(180)
  required  Boolean                @default(true)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  job       Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, category, valueCode])
  @@index([category, valueCode])
  @@map("job_requirements")
  @@schema("recruitment")
}

enum JobApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEWING
  OFFERED
  REJECTED
  WITHDRAWN
  HIRED

  @@schema("recruitment")
}

model JobApplication {
  id                    String                  @id @default(uuid()) @db.Uuid
  jobId                 String                  @map("job_id") @db.Uuid
  professionalProfileId String                  @map("professional_profile_id") @db.Uuid
  coverNote             String?                 @map("cover_note") @db.Text
  status                JobApplicationStatus    @default(SUBMITTED)
  submittedAt           DateTime                @default(now()) @map("submitted_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  job                   Job                     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  professional          ProfessionalProfile     @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  history               JobApplicationHistory[]
  interviews            Interview[]
  offers                JobOffer[]

  @@unique([jobId, professionalProfileId])
  @@index([professionalProfileId, status, submittedAt])
  @@index([jobId, status, submittedAt])
  @@map("job_applications")
  @@schema("recruitment")
}

enum InterviewMode {
  VIDEO
  PHONE
  IN_PERSON

  @@schema("recruitment")
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED

  @@schema("recruitment")
}

model Interview {
  id                   String          @id @default(uuid()) @db.Uuid
  applicationId        String          @map("application_id") @db.Uuid
  scheduledByAccountId String          @map("scheduled_by_account_id") @db.Uuid
  startsAt             DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime        @map("ends_at") @db.Timestamptz(3)
  timeZone             String          @map("time_zone") @db.VarChar(80)
  mode                 InterviewMode
  location             String?         @db.VarChar(500)
  joinUrl              String?         @map("join_url") @db.VarChar(1000)
  notes                String?         @db.Text
  status               InterviewStatus @default(SCHEDULED)
  cancellationReason   String?         @map("cancellation_reason") @db.Text
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  application          JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, startsAt])
  @@index([status, startsAt])
  @@map("interviews")
  @@schema("recruitment")
}

enum JobOfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED

  @@schema("recruitment")
}

model JobOffer {
  id                 String         @id @default(uuid()) @db.Uuid
  applicationId      String         @map("application_id") @db.Uuid
  createdByAccountId String         @map("created_by_account_id") @db.Uuid
  salaryMonthly      Int            @map("salary_monthly")
  currencyCode       String         @map("currency_code") @db.Char(3)
  proposedStartDate  DateTime       @map("proposed_start_date") @db.Date
  expiresAt          DateTime       @map("expires_at") @db.Timestamptz(3)
  terms              String         @db.Text
  status             JobOfferStatus @default(DRAFT)
  sentAt             DateTime?      @map("sent_at") @db.Timestamptz(3)
  respondedAt        DateTime?      @map("responded_at") @db.Timestamptz(3)
  responseReason     String?        @map("response_reason") @db.Text
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  application        JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employment         Employment?

  @@index([applicationId, status, createdAt])
  @@index([status, expiresAt])
  @@map("job_offers")
  @@schema("recruitment")
}

enum EmploymentStatus {
  CONFIRMED
  ACTIVE
  ENDED
  CANCELLED

  @@schema("recruitment")
}

model Employment {
  id                    String              @id @default(uuid()) @db.Uuid
  offerId               String              @unique @map("offer_id") @db.Uuid
  jobId                 String              @map("job_id") @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  professionalProfileId String              @map("professional_profile_id") @db.Uuid
  confirmedByAccountId  String              @map("confirmed_by_account_id") @db.Uuid
  title                 String              @db.VarChar(180)
  employmentType        EmploymentType      @map("employment_type")
  startDate             DateTime            @map("start_date") @db.Date
  endDate               DateTime?           @map("end_date") @db.Date
  status                EmploymentStatus    @default(ACTIVE)
  verificationSource    String              @default("ORGANIZATION_CONFIRMED") @map("verification_source") @db.VarChar(80)
  confirmedAt           DateTime            @default(now()) @map("confirmed_at") @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  offer                 JobOffer            @relation(fields: [offerId], references: [id], onDelete: Restrict)
  job                   Job                 @relation(fields: [jobId], references: [id], onDelete: Restrict)
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  professional          ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  history               EmploymentHistory[]

  @@index([professionalProfileId, status, startDate])
  @@index([organizationId, status, startDate])
  @@map("employments")
  @@schema("recruitment")
}

model EmploymentHistory {
  id             String            @id @default(uuid()) @db.Uuid
  employmentId   String            @map("employment_id") @db.Uuid
  fromStatus     EmploymentStatus? @map("from_status")
  toStatus       EmploymentStatus  @map("to_status")
  actorAccountId String            @map("actor_account_id") @db.Uuid
  reason         String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  employment     Employment        @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@index([employmentId, createdAt])
  @@map("employment_history")
  @@schema("recruitment")
}

model JobApplicationHistory {
  id             String                @id @default(uuid()) @db.Uuid
  applicationId  String                @map("application_id") @db.Uuid
  fromStatus     JobApplicationStatus? @map("from_status")
  toStatus       JobApplicationStatus  @map("to_status")
  actorAccountId String                @map("actor_account_id") @db.Uuid
  reason         String?               @db.Text
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  application    JobApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("job_application_history")
  @@schema("recruitment")
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@schema("organizations")
}

model OrganizationInvitation {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @map("organization_id") @db.Uuid
  email          String                       @db.VarChar(320)
  role           OrganizationMemberRole
  tokenHash      String                       @unique @map("token_hash") @db.Char(64)
  status         OrganizationInvitationStatus @default(PENDING)
  invitedBy      String                       @map("invited_by") @db.Uuid
  expiresAt      DateTime                     @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?                    @map("accepted_at") @db.Timestamptz(3)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([email, status])
  @@map("organization_invitations")
  @@schema("organizations")
}

enum OrganizationVerificationStatus {
  EVIDENCE_REQUIRED
  READY_TO_SUBMIT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  VERIFIED
  REJECTED

  @@schema("organizations")
}

enum OrganizationVerificationDecisionAction {
  NEEDS_INFORMATION
  VERIFIED
  REJECTED

  @@schema("organizations")
}

model OrganizationVerificationRequest {
  id                 String                             @id @default(uuid()) @db.Uuid
  organizationId     String                             @unique @map("organization_id") @db.Uuid
  status             OrganizationVerificationStatus     @default(EVIDENCE_REQUIRED)
  assignedReviewerId String?                            @map("assigned_reviewer_id") @db.Uuid
  submittedAt        DateTime?                          @map("submitted_at") @db.Timestamptz(3)
  reviewedAt         DateTime?                          @map("reviewed_at") @db.Timestamptz(3)
  createdAt          DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedReviewer   Account?                           @relation("AssignedOrganizationReviewer", fields: [assignedReviewerId], references: [id], onDelete: Restrict)
  evidence           OrganizationVerificationEvidence[]
  decisions          OrganizationVerificationDecision[]

  @@index([status, submittedAt])
  @@index([assignedReviewerId, status])
  @@map("organization_verification_requests")
  @@schema("organizations")
}

model OrganizationVerificationEvidence {
  id                    String                          @id @default(uuid()) @db.Uuid
  verificationRequestId String                          @map("verification_request_id") @db.Uuid
  fileObjectId          String                          @unique @map("file_object_id") @db.Uuid
  kind                  String                          @default("BUSINESS_REGISTRATION") @db.VarChar(60)
  createdAt             DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  verificationRequest   OrganizationVerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@index([verificationRequestId, createdAt])
  @@map("organization_verification_evidence")
  @@schema("organizations")
}

model OrganizationVerificationDecision {
  id                    String                                 @id @default(uuid()) @db.Uuid
  verificationRequestId String                                 @map("verification_request_id") @db.Uuid
  reviewerAccountId     String                                 @map("reviewer_account_id") @db.Uuid
  action                OrganizationVerificationDecisionAction
  reason                String?                                @db.Text
  createdAt             DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  verificationRequest   OrganizationVerificationRequest        @relation(fields: [verificationRequestId], references: [id], onDelete: Restrict)
  reviewer              Account                                @relation(fields: [reviewerAccountId], references: [id], onDelete: Restrict)

  @@index([verificationRequestId, createdAt])
  @@index([reviewerAccountId, createdAt])
  @@map("organization_verification_decisions")
  @@schema("organizations")
}

model OrganizationMembership {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  accountId      String                 @map("account_id") @db.Uuid
  role           OrganizationMemberRole
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([organizationId, accountId])
  @@index([accountId])
  @@map("organization_memberships")
  @@schema("organizations")
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String   @map("actor_id") @db.VarChar(120)
  action        String   @db.VarChar(160)
  resourceType  String   @map("resource_type") @db.VarChar(120)
  resourceId    String   @map("resource_id") @db.VarChar(120)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  correlationId String   @map("correlation_id") @db.VarChar(120)
  reason        String?  @db.Text
  changes       Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([resourceType, resourceId, occurredAt])
  @@index([actorId, occurredAt])
  @@map("audit_events")
  @@schema("audit")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED

  @@schema("platform")
}

model OutboxEvent {
  id            String       @id @db.Uuid
  name          String       @db.VarChar(160)
  version       Int
  aggregateId   String       @map("aggregate_id") @db.VarChar(120)
  correlationId String       @map("correlation_id") @db.VarChar(120)
  causationId   String?      @map("causation_id") @db.VarChar(120)
  payload       Json
  occurredAt    DateTime     @map("occurred_at") @db.Timestamptz(3)
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, occurredAt])
  @@map("outbox_events")
  @@schema("platform")
}
